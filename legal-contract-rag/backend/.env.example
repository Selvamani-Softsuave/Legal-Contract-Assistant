# ─── Application Environment ───────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Database (SQL Server) ──────────────────────────────────────────────
DATABASE_URL=mssql+pyodbc://sa:LegalRAG_Password2026!@localhost:1433/LegalContractRAG?driver=ODBC+Driver+17+for+SQL+Server

# ─── Azure Storage / Azurite Emulator ──────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;QueueEndpoint=http://localhost:10001/devstoreaccount1;
BLOB_CONTAINER_NAME=legal-contracts-blob
QUEUE_NAME=legal-document-processing

# ─── Microservices Endpoints ───────────────────────────────────────────
DOCUMENT_PROCESSOR_URL=http://localhost:7071
BACKEND_API_URL=http://localhost:8080

# ─── Vector Store (ChromaDB) ───────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
COLLECTION_NAME=legal_contracts

# ═════════════════════════════════════════════════════════════════════════
# AI PROVIDER CONFIGURATION (Select ONE provider; others remain commented)
# ═════════════════════════════════════════════════════════════════════════

# ─── [ENABLED] Option 1: Local Ollama (100% Free / Local Default) ────────
LLM_PROVIDER=OLLAMA
LLM_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# ─── [DISABLED] Option 2: Google Gemini (Free Tier via Google AI Studio) ─
# LLM_PROVIDER=GEMINI
# API_KEY=your-gemini-api-key-here
# LLM_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=gemini-embedding-001

# ─── [DISABLED] Option 3: OpenRouter (Free-tier Models & Free Router) ────
# LLM_PROVIDER=OPENROUTER
# API_KEY=your-openrouter-api-key-here
# LLM_MODEL=openrouter/free
# EMBEDDING_MODEL=jinaeu/jina-embeddings-v2-base-en

# ─── RAG Retrieval Parameters ──────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5

# ─── Week 4 Hybrid RAG Parameters ─────────────────────────────────────
HYBRID_RETRIEVAL_ENABLED=True
RRF_K=60
BM25_TOP_K=10
SEMANTIC_TOP_K=10
HYBRID_FINAL_TOP_K=5
