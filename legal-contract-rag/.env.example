# ─── Application Environment ───────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Database (SQL Server) ──────────────────────────────────────────────
DATABASE_URL=mssql+pyodbc://sa:LegalRAG_Password2026!@localhost:1433/LegalContractRAG?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# ─── Azure Storage / Azurite Emulator ──────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;QueueEndpoint=http://localhost:10001/devstoreaccount1;
BLOB_CONTAINER_NAME=legal-contracts-blob
QUEUE_NAME=legal-document-processing

# ─── Microservices Endpoints ───────────────────────────────────────────
DOCUMENT_PROCESSOR_URL=http://localhost:7071
BACKEND_API_URL=http://localhost:8080

# ─── Vector Store (ChromaDB) ───────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
COLLECTION_NAME=legal_contracts

# ─── Dynamic AI Provider Configuration ────────────────────────────────
# Set AI_PROVIDER to: OLLAMA, OPENROUTER, OPENAI, GEMINI, GROQ, DEEPSEEK, CUSTOM
AI_PROVIDER=OLLAMA

# Shared API key for cloud providers (OpenRouter, OpenAI, Gemini, Groq, DeepSeek)
AI_API_KEY=your-api-key-here

# Optional: Override default models if desired
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# EMBEDDING_MODEL=jinaeu/jina-embeddings-v2-base-en

# ─── Ollama Configuration (Local Default) ──────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT=120
OLLAMA_EMBEDDING_BATCH_SIZE=10

# ─── RAG Parameters ───────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
