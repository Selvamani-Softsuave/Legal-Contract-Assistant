# ═════════════════════════════════════════════════════════════════════════
# Enterprise Legal Contract RAG & Assistant Platform — Environment Config
# ═════════════════════════════════════════════════════════════════════════
# Instructions: Copy this file to '.env' and populate with your environment secrets.
# NEVER commit sensitive API keys or credentials to public source control.

# ─── Application & Environment Settings ──────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME=Enterprise Legal Contract RAG
VERSION=2.0.0

# ─── Frontend Configuration ──────────────────────────────────────────────
FRONTEND_PORT=4201

# ─── Microservices Internal Networking ───────────────────────────────────
DOCUMENT_PROCESSOR_URL=http://localhost:7071
BACKEND_API_URL=http://localhost:8080

# ─── Relational Database (SQL Server 2022) ───────────────────────────────
# Default development SA password conforms to Microsoft SQL Server password complexity
MSSQL_SA_PASSWORD=LegalRAG_Password2026!
DATABASE_URL=mssql+pyodbc://sa:LegalRAG_Password2026!@localhost:1433/LegalContractRAG?driver=ODBC+Driver+17+for+SQL+Server

# ─── Azure Storage & Azurite Emulator ────────────────────────────────────
# Pre-configured for local Azurite emulator (default development account)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;QueueEndpoint=http://localhost:10001/devstoreaccount1;TableEndpoint=http://localhost:10002/devstoreaccount1;
BLOB_CONTAINER_NAME=legal-contracts-blob
QUEUE_NAME=legal-document-processing

# ─── Vector Store (ChromaDB 0.5.20) ──────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
COLLECTION_NAME=legal_contracts

# ═════════════════════════════════════════════════════════════════════════
# DYNAMIC AI PROVIDER CONFIGURATION (Select ONE active provider)
# Supported Providers: GEMINI, OLLAMA, OPENROUTER, OPENAI
# ═════════════════════════════════════════════════════════════════════════

# ─── [ACTIVE DEFAULT] Option 1: Google Gemini API ────────────────────────
AI_PROVIDER=GEMINI
LLM_PROVIDER=GEMINI
EMBEDDING_PROVIDER=GEMINI
AI_API_KEY=your-gemini-api-key-here
API_KEY=your-gemini-api-key-here
LLM_MODEL=gemma-4-26b-a4b-it
EMBEDDING_MODEL=gemini-embedding-001

# ─── [OFFLINE DEFAULT] Option 2: Local Ollama (100% Offline & Free) ──────
# AI_PROVIDER=OLLAMA
# LLM_PROVIDER=OLLAMA
# EMBEDDING_PROVIDER=OLLAMA
# LLM_MODEL=llama3.2
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# ─── [CLOUD ALTERNATIVE] Option 3: OpenRouter (Multi-model Router) ───────
# AI_PROVIDER=OPENROUTER
# LLM_PROVIDER=OPENROUTER
# EMBEDDING_PROVIDER=OPENROUTER
# API_KEY=your-openrouter-api-key-here
# LLM_MODEL=openrouter/free
# EMBEDDING_MODEL=jinaeu/jina-embeddings-v2-base-en

# ─── [CLOUD ALTERNATIVE] Option 4: Direct OpenAI ─────────────────────────
# AI_PROVIDER=OPENAI
# LLM_PROVIDER=OPENAI
# EMBEDDING_PROVIDER=OPENAI
# API_KEY=your-openai-api-key-here
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ─── RAG & Retrieval Parameters ──────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
HYBRID_SEARCH_ENABLED=False
RRF_K=60
